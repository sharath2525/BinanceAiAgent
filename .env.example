# Configuration for Agent Invoice
PORT=3000

# ==========================================
# AGENT WALLET & PRICING
# ==========================================
# The 0x address where all analysis and live mode payments will be sent
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Prices for the services (in USDC)
ANALYSIS_PRICE_USDC=0.01
LIVE_MODE_PRICE_USDC=0.05

# How long a user has to complete the payment (in seconds)
PAYMENT_TIMEOUT_SECONDS=300

# Threshold in USDC before the agent automatically reinvests in BNB via Binance MCP
BNB_REINVEST_THRESHOLD=10.00

# ==========================================
# BINANCE INTEGRATION
# ==========================================
# The Binance Agent OS MCP Server URL
BINANCE_MCP_URL=http://localhost:8080

# Binance API Key (if required by your MCP setup)
# BINANCE_API_KEY=your_key_here
# BINANCE_API_SECRET=your_secret_here

# ==========================================
# BLOCKCHAIN RPC ENDPOINTS (Optional overrides)
# ==========================================
# The backend uses default public RPCs, but you can override them here for better reliability
# BNB_CHAIN_RPC=https://bsc-dataseed.binance.org/
# ETH_RPC=https://cloudflare-eth.com
# POLYGON_RPC=https://polygon-rpc.com
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# BASE_RPC=https://mainnet.base.org
# OPTIMISM_RPC=https://mainnet.optimism.io

# ==========================================
# DEVELOPMENT / TESTING
# ==========================================
# Set to 'true' to skip actual on-chain verification (useful for UI testing)
# DEMO_MODE=false
