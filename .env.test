# ─────────────────────────────────────────────
# .env.test  —  Local testing config (no real keys needed)
# Copy this to .env to run in demo mode:
#   cp .env.test .env
#   node index.js
# ─────────────────────────────────────────────

# DEMO MODE skips real payment verification.
# Any text in the tx hash field will be accepted.
DEMO_MODE=true

# MCP will fail gracefully in demo mode — analysis will
# use mock data if Binance MCP is unreachable.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_API_KEY=demo_key_not_real
BINANCE_SECRET_KEY=demo_secret_not_real

# Leave these as-is for demo (no real wallet needed)
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_PRIVATE_KEY=demo_private_key_not_real

# BNB Chain (not called in demo mode)
BNB_CHAIN_RPC=https://bsc-dataseed.binance.org/
USDC_CONTRACT_BSC=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# Server
PORT=3000

# Price (in demo mode this is just a display value)
ANALYSIS_PRICE_USDC=0.01

# Reinvest threshold (BNB buy won't trigger without real API)
BNB_REINVEST_THRESHOLD=10

# Invoice timeout in seconds
PAYMENT_TIMEOUT_SECONDS=300
